from typing import List, Protocol

class Drawable(Protocol):
    def draw(self) ->str:
        pass

def render_all(items: List[Drawable]) -> None:
    for i, obj in enumerate(items, 1):
        print(f"{i}. {obj.draw()}")

class Button:
    def draw(self) -> str:
        return "[Кнопка]"

class Icon:
    def draw(self) ->str:
        return "(Иконка)"

items = [Button(), Icon(), Button(), Button()]
render_all(items)


class Dashboard:
    def __init__(self):
        self._widgets: list[Drawable] = []


    def add(self, w:Drawable):
        self._widgets.append(w)

    def render(self):
        for w in self._widgets:
            print(w.draw())

d = Dashboard()
d.add(Button())
d.add(Icon())
d.add(Button())
d.render()
